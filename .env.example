# Salin sebagai .env dan ganti seluruh nilai rahasia sebelum produksi.
AQMS_DB_NAME=partikulat
AQMS_DB_USER=aqms
AQMS_DB_PASSWORD=ganti-dengan-password-kuat
AQMS_DB_ROOT_PASSWORD=ganti-dengan-password-root-kuat
AQMS_DISPLAY_NAME=PARTIKULAT 02
AQMS_ORGANIZATION_NAME=DINAS LINGKUNGAN HIDUP KABUPATEN SANGGAU
AQMS_TIMEZONE=Asia/Jakarta
AQMS_HTTP_BIND=127.0.0.1
AQMS_HTTP_PORT=18080
AQMS_INGEST_ALLOWED_CIDRS=192.168.1.22/32
AQMS_INGEST_TOKEN=
AQMS_INGEST_MIN_INTERVAL_SECONDS=1

# Kontrol daya dinonaktifkan sampai broker host dipasang dan PIN dibuat dengan
# scripts/set-admin-pin.sh. Jangan menulis PIN polos di file ini.
AQMS_POWER_CONTROLS_ENABLED=false
AQMS_ADMIN_PIN_HASH=
AQMS_CONTROL_DIR=/run/aqms-control

# QR akses data ditampilkan hanya setelah PIN admin berhasil diverifikasi.
# AQMS_WIFI_PSK adalah rahasia dan tidak boleh dikomit.
AQMS_WIFI_SSID=PARTIKULAT02
AQMS_WIFI_PSK=
AQMS_WIFI_HIDDEN=false
AQMS_DATA_URL=http://192.168.100.135/display/
